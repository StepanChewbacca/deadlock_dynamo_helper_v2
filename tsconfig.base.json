{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@deadlock-live-probe/shared": [
        "packages/shared/src"
      ],
      "@deadlock-live-probe/build-domain": [
        "packages/deadlock-build-domain/src"
      ]
    }
  }
}
